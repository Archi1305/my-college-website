fill="none"><path d="M3.21091 5.7511L0.221668 8.71778C-0.073888 9.01111 -0.0738885 9.48668 0.221668 9.78001C0.517224 10.0733 0.996414 10.0733 1.29197 9.78001L4.21629 6.87776C5.26124 5.8407 5.26124 4.1593 4.21629 3.12224L1.29197 0.219993C0.996415 -0.0733312 0.517224 -0.0733312 0.221668 0.219993C-0.0738885 0.513318 -0.0738885 0.988891 0.221667 1.28222L3.21091 4.24889C3.62889 4.66372 3.62889 5.33628 3.21091 5.7511Z" fill="#808080"></path></svg></div><div class="jsx-6e9fff2aaa51f20c alternateSeoUrls"><a href="/news/category/publications" class="jsx-6e9fff2aaa51f20c alternateSeoUrlsAClass">Publications</a><a href="/news/category/ideas" class="jsx-6e9fff2aaa51f20c alternateSeoUrlsAClass">Ideas</a><a href="/news/category/from_dwello" class="jsx-6e9fff2aaa51f20c alternateSeoUrlsAClass">From dwello</a><a href="/news/category/innovations" class="jsx-6e9fff2aaa51f20c alternateSeoUrlsAClass">Innovations</a><a href="/news/category/dictations" class="jsx-6e9fff2aaa51f20c alternateSeoUrlsAClass">Dictations</a><a href="/news/category/interactions" class="jsx-6e9fff2aaa51f20c alternateSeoUrlsAClass">Interactions</a><a href="/news/category/all_about_rera" class="jsx-6e9fff2aaa51f20c alternateSeoUrlsAClass">All about rera</a><a href="/news/category/recommendations" class="jsx-6e9fff2aaa51f20c alternateSeoUrlsAClass">Recommendations</a><a href="/news/category/representations" class="jsx-6e9fff2aaa51f20c alternateSeoUrlsAClass">Representations</a></div></div><div class="jsx-6e9fff2aaa51f20c breadcrumbText"><a href="/news/category/innovations/contemporary_ideas" class="jsx-6e9fff2aaa51f20c breadcrumbTextAClass">Contemporary ideas<!-- --> </a><div class="jsx-6e9fff2aaa51f20c angleRight"><svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 5 10" fill="none"><path d="M3.21091 5.7511L0.221668 8.71778C-0.073888 9.01111 -0.0738885 9.48668 0.221668 9.78001C0.517224 10.0733 0.996414 10.0733 1.29197 9.78001L4.21629 6.87776C5.26124 5.8407 5.26124 4.1593 4.21629 3.12224L1